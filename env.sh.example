# Copy to env.sh, edit the four paths, then `source env.sh` before anything else.
source ~/anaconda3/etc/profile.d/conda.sh && conda activate etqnn

export EXECUTORCH_ROOT=$HOME/dev/llm/executorch     # the checkout you apply patch/ to
export QNN_SDK_ROOT=$HOME/qairt/2.37.1-v81          # QAIRT 2.37.1 + the v81 skel mirror (see docs/export-guide.md)
export ANDROID_NDK_ROOT=$HOME/android-ndk-r26d

# This line is what makes the repo win over the installed executorch wheel. Without it a newly
# registered model dies with KeyError, or -- worse -- stale site-packages code runs silently.
export PYTHONPATH=$EXECUTORCH_ROOT/..:$PYTHONPATH
export LD_LIBRARY_PATH=$QNN_SDK_ROOT/lib/x86_64-linux-clang:$LD_LIBRARY_PATH

# Verify: this must print a path under $EXECUTORCH_ROOT, not site-packages.
# python -c "import executorch.examples.qualcomm.oss_scripts.llama as m; print(m.__file__)"
