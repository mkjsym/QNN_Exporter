new file mode 100644
index 0000000..dd19862
--- /dev/null
+++ b/examples/qualcomm/oss_scripts/llama/model/dflash_draft.py
@@ -0,0 +1,337 @@
+# Copyright (c) Qualcomm Innovation Center, Inc.
+# All rights reserved
+#
+# This source code is licensed under the BSD-style license found in the
+# LICENSE file in the root directory of this source tree.
+"""DFlash speculative-decoding draft head, as a single fused graph.
+
+A DFlash draft is a small decoder (5 layers) that proposes a block of tokens for a large target to
+verify. It differs from an ordinary decoder in where its keys and values come from:
+
+    Q  comes from the block rows only -- the masked positions being proposed.
+    KV comes from two places: the block rows, and the *target's* hidden states for the tokens that
+       have already been committed, projected once by fc + hidden_norm.
+
+The committed-token branch is what makes this worth a custom module. Those rows never join the
+residual stream: every layer projects K and V straight off the same fc output, so the branch has no
+sequential dependency on the block branch at all. Reference implementations (and our llama.cpp port)
+still run it as a separate "inject" pass followed by a "block" pass, which is a KV-cache-plumbing
+convenience rather than anything the architecture asks for.
+
+On a QNN target that split is expensive. Per-call cost there is essentially pure weight streaming --
+measured at -3.9 ms + 18.0 ms/GB across three contexts, i.e. an intercept of zero -- so cost is set
+by how many times the weights are read, not by how much work each read does. Two passes cost twice
+one pass even though the inject pass is a handful of rows. Fusing them into one graph is therefore
+worth roughly the whole inject stage, and it is exact, not an approximation.
+
+Padding the committed-row count to a fixed maximum is free for the same reason, which is what makes
+a static export viable at all: `n_inject` rows are always processed, and the caller masks off the
+ones that are not real.
+
+The five target hidden states arrive as five separate tensors rather than one concatenation, and fc
+is carried as five blocks that are summed -- algebraically the same projection, but it gives each
+layer its own activation scale. Concatenating first would force one scale across all five, and they
+are not remotely comparable: measured on Qwen3-4B over Spec-Bench prompts, layer 1 spans +/-60 with
+mean |x| 0.155 while layers 9-33 reach 16384 through a handful of always-large channels (21 of
+12800 exceed 100, at fixed positions 0, 4 and 396 within each block). One 16-bit scale set by 16384
+gives a step of 0.32, which rounds most of layer 1 to zero -- the layer would be gone.
+"""
+
+from typing import List, Optional, Tuple
+
+import torch
+import torch.nn as nn
+
+from executorch.examples.models.llama.model_args import ModelArgs
+
+from executorch.examples.qualcomm.oss_scripts.llama.masking_utils import (
+    AttentionMask,
+    CausalAttentionMask,
+)
+
+from .static_llama import (
+    LlamaAttention,
+    LlamaDecoderLayer,
+    LlamaModel,
+    NORM_REGISTRY,
+    repeat_kv,
+)
+
+
+class DFlashAttention(LlamaAttention):
+    """LlamaAttention with a second, layer-invariant KV source.
+
+    `g_ctx` is the fc-projected target hidden for the committed tokens. It is already normalized
+    (hidden_norm runs once, in the model) and is deliberately NOT passed through the per-layer
+    attention_norm -- the reference projects it raw at every layer.
+
+    Only the committed rows are returned as new cache entries. The block rows' K/V are speculative:
+    they are consumed by this call's own attention and then thrown away, because the next step
+    re-derives them from whatever the target actually accepted.
+    """
+
+    def _ctx_kv(self, g_ctx, freqs_cos_ctx, freqs_sin_ctx, conv: bool):
+        bsz, ctx_len, _ = g_ctx.shape
+        if conv:
+            g = torch.reshape(g_ctx, (bsz, ctx_len, 1, self.dim)).transpose(1, 3)
+            k = self.wk_conv(g).permute(0, 3, 1, 2).squeeze(-1)
+            v = self.wv_conv(g).permute(0, 3, 1, 2).squeeze(-1)
+        else:
+            k = self.wk(g_ctx)
+            v = self.wv(g_ctx)
+        k = k.view(bsz, ctx_len, self.n_kv_heads, self.head_dim).transpose(1, 2)
+        v = v.view(bsz, ctx_len, self.n_kv_heads, self.head_dim).transpose(1, 2)
+
+        # k_norm applies to the committed keys too: the reference norms the concatenation of
+        # context and block keys, so both sides see it.
+        if self.use_qk_norm and self.qk_norm_before_rope:
+            k = self.k_norm_fn(k)
+        if self.use_rope:
+            k = self.apply_rope_emb(k, freqs_cos_ctx, freqs_sin_ctx)
+        if self.use_qk_norm and not self.qk_norm_before_rope:
+            k = self.k_norm_fn(k)
+        if getattr(self.config, "enable_r3", False):
+            k = torch.matmul(k, self.r3_weight)
+        return k.transpose(2, 3), v
+
+    def _forward_impl(
+        self,
+        hidden_states: torch.Tensor,
+        g_ctx: torch.Tensor,
+        freqs_cos: torch.Tensor,
+        freqs_sin: torch.Tensor,
+        freqs_cos_ctx: torch.Tensor,
+        freqs_sin_ctx: torch.Tensor,
+        atten_mask: torch.Tensor,
+        k_caches: List[torch.Tensor],
+        v_caches: List[torch.Tensor],
+        conv: bool,
+    ) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        bsz, seq_len, _ = hidden_states.shape
+
+        if conv:
+            h = torch.reshape(hidden_states, (bsz, seq_len, 1, self.dim)).transpose(1, 3)
+            q = self.wq_conv(h).permute(0, 3, 1, 2).squeeze(-1)
+            k = self.wk_conv(h).permute(0, 3, 1, 2).squeeze(-1)
+            v = self.wv_conv(h).permute(0, 3, 1, 2).squeeze(-1)
+        else:
+            q = self.wq(hidden_states)
+            k = self.wk(hidden_states)
+            v = self.wv(hidden_states)
+        q = q.view(bsz, seq_len, self.n_heads, self.head_dim).transpose(1, 2)
+        k = k.view(bsz, seq_len, self.n_kv_heads, self.head_dim).transpose(1, 2)
+        v = v.view(bsz, seq_len, self.n_kv_heads, self.head_dim).transpose(1, 2)
+
+        if self.use_qk_norm and self.qk_norm_before_rope:
+            q = self.q_norm_fn(q)
+            k = self.k_norm_fn(k)
+        if self.use_rope:
+            q = self.apply_rope_emb(q, freqs_cos, freqs_sin)
+            k = self.apply_rope_emb(k, freqs_cos, freqs_sin)
+        if self.use_qk_norm and not self.qk_norm_before_rope:
+            q = self.q_norm_fn(q)
+            k = self.k_norm_fn(k)
+        if getattr(self.config, "enable_r3", False):
+            q = torch.matmul(q, self.r3_weight)
+            k = torch.matmul(k, self.r3_weight)
+        k = k.transpose(2, 3)
+
+        k_ctx, v_ctx = self._ctx_kv(g_ctx, freqs_cos_ctx, freqs_sin_ctx, conv)
+
+        # order matters: [ past | committed-this-step | block ] must match how the caller lays out
+        # atten_mask and how the runtime appends k_ctx/v_ctx to the cache.
+        kh = torch.cat([k_caches, k_ctx, k], dim=-1)
+        vh = torch.cat([v_caches, v_ctx, v], dim=2)
+
+        kh = repeat_kv(kh, self.num_key_value_groups)
+        vh = repeat_kv(vh, self.num_key_value_groups)
+
+        attn = q @ kh
+        attn = attn / self.scale
+        if self.enable_masked_softmax:
+            attn_min = torch.amin(attn, dim=-1, keepdim=True)
+            attn = torch.where(atten_mask == 0, attn, attn_min + (-20))
+        else:
+            attn = attn + atten_mask
+        attn = self.attn_softmax(attn)
+        y = attn @ vh
+        y = y.transpose(1, 2)
+        if conv:
+            y = y.reshape(bsz, seq_len, 1, -1).transpose(1, 3)
+            y = self.wo_conv(y).transpose(1, 3).reshape(bsz, seq_len, -1)
+        else:
+            y = y.reshape(bsz, seq_len, -1)
+            y = self.wo(y)
+
+        # only the committed rows persist; the block's own K/V die with this call
+        return y, [k_ctx], [v_ctx]
+
+    def forward(self, hidden_states, g_ctx, freqs_cos, freqs_sin, freqs_cos_ctx,
+                freqs_sin_ctx, atten_mask, k_caches, v_caches):
+        return self._forward_impl(hidden_states, g_ctx, freqs_cos, freqs_sin,
+                                  freqs_cos_ctx, freqs_sin_ctx, atten_mask,
+                                  k_caches, v_caches, conv=False)
+
+    def forward_attention_conv(self, hidden_states, g_ctx, freqs_cos, freqs_sin,
+                               freqs_cos_ctx, freqs_sin_ctx, atten_mask, k_caches, v_caches):
+        return self._forward_impl(hidden_states, g_ctx, freqs_cos, freqs_sin,
+                                  freqs_cos_ctx, freqs_sin_ctx, atten_mask,
+                                  k_caches, v_caches, conv=True)
+
+
+class DFlashDecoderLayer(LlamaDecoderLayer):
+    def __init__(self, layer_idx: int, config: ModelArgs, output_new_cache_only=False):
+        super().__init__(layer_idx, config, output_new_cache_only)
+        self.attention = DFlashAttention(
+            layer_idx=layer_idx, config=config, output_new_cache_only=output_new_cache_only
+        )
+
+    def forward(self, x, g_ctx, freqs_cos, freqs_sin, freqs_cos_ctx, freqs_sin_ctx,
+                atten_mask, k_caches, v_caches):
+        hidden_states = self.attention_norm(x)
+        h, k_cache, v_cache = self.attention(
+            hidden_states=hidden_states,
+            g_ctx=g_ctx,
+            freqs_cos=freqs_cos,
+            freqs_sin=freqs_sin,
+            freqs_cos_ctx=freqs_cos_ctx,
+            freqs_sin_ctx=freqs_sin_ctx,
+            atten_mask=atten_mask,
+            k_caches=k_caches,
+            v_caches=v_caches,
+        )
+        h = x + h
+        out = self.feed_forward(self.ffn_norm(h))
+        return h + out, k_cache, v_cache
+
+
+class DFlashDraftModel(LlamaModel):
+    """One graph per decoding step: commit the accepted tokens and propose the next block.
+
+    ar_len is the block width (how many masked positions are proposed). n_inject is the fixed number
+    of committed rows carried in alongside; the caller pads up to it and masks the remainder.
+    """
+
+    def __init__(self, config: ModelArgs, ar_len=1, output_new_cache_only=True,
+                 output_cache=True, use_i64_token=False, n_inject=8,
+                 n_target_layers=5, **kwargs):
+        super().__init__(
+            config=config, ar_len=ar_len, output_new_cache_only=output_new_cache_only,
+            output_cache=output_cache, use_i64_token=use_i64_token, **kwargs
+        )
+        self.n_inject = n_inject
+        self.n_target_layers = n_target_layers
+        self.layers = nn.ModuleList(
+            [DFlashDecoderLayer(i, config, output_new_cache_only) for i in range(config.n_layers)]
+        )
+        # one block per target layer, summed in forward: sum_i fc_i(h_i) == fc(cat(h_i))
+        self.fc = nn.ModuleList(
+            [nn.Linear(config.dim, config.dim, bias=False) for _ in range(n_target_layers)]
+        )
+        self.hidden_norm = NORM_REGISTRY[config.norm_type](config.dim, eps=config.norm_eps)
+
+    def forward(
+        self,
+        h_0: torch.Tensor,
+        h_1: torch.Tensor,
+        h_2: torch.Tensor,
+        h_3: torch.Tensor,
+        h_4: torch.Tensor,
+        block_embd: torch.Tensor,
+        atten_mask: torch.Tensor,
+        input_pos: torch.Tensor,
+        input_pos_ctx: torch.Tensor,
+        *args,
+    ) -> Tuple[torch.Tensor, List[torch.Tensor], List[torch.Tensor]]:
+        """One target hidden per layer, named rather than packed.
+
+        The five could have been one varargs tail, and briefly were. But the export pipeline
+        identifies KV cache inputs by placeholder name -- it looks for `args_<i>` and reads <i> as
+        the layer index -- so anything else sharing that varargs would be mistaken for a cache. Only
+        the caches may be varargs; everything in front has to be named.
+
+        Fixed at five because that is what a DFlash draft is: `target_layer_ids` has five entries
+        for both the 4B and 8B heads, and fc is built to match.
+        """
+        assert self.n_target_layers == 5, (
+            f"this forward names five target hidden inputs; config says {self.n_target_layers}"
+        )
+        target_hidden = [h_0, h_1, h_2, h_3, h_4]
+
+        # block_embd, not token ids: the caller looks the block up and hands over the vectors. The
+        # embedding table is 29.6% of this model's weights (389M of 1315M, a 151936x2560 table the
+        # draft carries a second copy of because output.weight holds the same values in its own
+        # storage), and keeping the lookup in the graph makes the NPU stream all of it to fetch
+        # eight rows a step. On a device whose per-call cost is weight streaming at ~18 ms/GB that
+        # is ~7 ms of every ~60 ms step. forward never touching self.tok_embeddings is what keeps
+        # the table out of the artifact: unused parameters are stripped at to_edge time. The table
+        # stays on the module for the calibration loop, and the host needs its own copy at fp16 --
+        # not the Q4_0 one the target GGUF already carries, which costs 5 of 8 argmax on its own
+        # (logit cosine 0.9371 against fp32; Q8_0 is 7 of 8, fp16 and bf16 are exact).
+
+        hidden_states = block_embd
+
+        output_k_cache = []
+        output_v_cache = []
+        freqs_cos = self.freqs_cos[input_pos][0]
+        freqs_sin = self.freqs_sin[input_pos][0]
+        freqs_cos_ctx = self.freqs_cos[input_pos_ctx][0]
+        freqs_sin_ctx = self.freqs_sin[input_pos_ctx][0]
+
+        g_ctx = self.hidden_norm(
+            sum(fc_i(h_i) for fc_i, h_i in zip(self.fc, target_hidden))
+        )
+
+        for ind, decoder_layer in enumerate(self.layers):
+            hidden_states, k, v = decoder_layer(
+                hidden_states,
+                g_ctx=g_ctx,
+                freqs_cos=freqs_cos,
+                freqs_sin=freqs_sin,
+                freqs_cos_ctx=freqs_cos_ctx,
+                freqs_sin_ctx=freqs_sin_ctx,
+                atten_mask=atten_mask,
+                k_caches=args[ind],
+                v_caches=args[self.n_layers + ind],
+            )
+            output_k_cache.extend(k)
+            output_v_cache.extend(v)
+
+        logits = self.output(self.norm(hidden_states))
+        if self.logits_scaling:
+            logits = logits / self.logits_scaling
+        if self.output_cache:
+            return logits, output_k_cache, output_v_cache
+        return logits
+
+    def get_example_inputs(self):
+        b, n_ctx = self.max_batch_size, self.n_inject
+        target_hidden = [
+            torch.randn((b, n_ctx, self.dim), dtype=torch.float32)
+            for _ in range(self.n_target_layers)
+        ]
+        block_embd = torch.randn((b, self.ar_len, self.dim), dtype=torch.float32)
+        # Total keys per step must come to max_seq_len, the width every mask in this pipeline is
+        # built at: past cache + this step's committed rows + the block.
+        cache_len = self.max_context_len - self.n_inject - self.ar_len
+        atten_mask = AttentionMask(
+            CausalAttentionMask(b, self.ar_len, self.max_context_len)
+        )
+        pos = torch.zeros((b, self.ar_len), dtype=torch.int32)
+        pos_ctx = torch.zeros((b, n_ctx), dtype=torch.int32)
+        k_cache, v_cache = [], []
+        for _ in range(self.n_layers):
+            k_cache.append(torch.zeros(b, self.n_kv_heads, self.head_dim, cache_len))
+            v_cache.append(torch.zeros(b, self.n_kv_heads, cache_len, self.head_dim))
+        # Nested, in the shape the wrapper's export_input builder indexes positionally; the model
+        # itself takes the flattened version that builder produces.
+        return (target_hidden, block_embd, atten_mask, pos, pos_ctx, k_cache, v_cache)
+
+    def get_attn_mask_template(self):
+        return self.get_example_inputs()[2]
+
+    def get_metadata(self):
+        meta = super().get_metadata()
+        meta["n_inject"] = self.n_inject
+        meta["n_target_layers"] = self.n_target_layers
+        return meta
