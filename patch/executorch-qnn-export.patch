+class DFlashDecoderInference(DecoderInference):
+    """Calibration/eval driver for a DFlash draft head.
+
+    Two things differ from an ordinary decoder. The graph takes seven inputs rather than five --
+    the target's hidden states and their positions ride alongside the block tokens -- and the
+    hidden states cannot be produced by this loop, because they come from a model that is not
+    being exported. They are replayed from a dump taken offline with the bf16 target
+    (see dump_target_hidden.py).
+
+    Replaying matters more than it sounds. Feed the observers token embeddings and `fc` learns a
+    range that has nothing to do with what it will see: on Qwen3-4B the target's layer-33 hidden
+    reaches 16384 through a few always-large channels while its mean |x| is 4.5. Calibrate on the
+    wrong distribution and the draft is quantized for a world it never inhabits.
+    """
+
+    def __init__(self, get_example_inputs: Callable, hidden_dump: str,
+                 n_inject: int = 16, n_target_layers: int = 5, embedding=None,
+                 mask_token_id: int = None, **kwargs):
+        ex = get_example_inputs()
+        assert len(ex) == 7, (
+            f"DFlashDecoderInference expects (target_hidden, tokens, atten_mask, pos, pos_ctx, "
+            f"k_caches, v_caches); got {len(ex)} elements."
+        )
+        _, _, self._default_attn_mask, _, _, self._k_caches, self._v_caches = ex
+        self.max_context_len = kwargs.get("max_context_len", 1024)
+        self.max_batch_size = kwargs.get("max_batch_size", 1)
+        self.audio_token_id = None
+        self.image_token_id = None
+        self._dtype = torch.int64 if kwargs.get("use_i64_token", False) else torch.int32
+        self.pos_ids = (
+            torch.arange(self.max_context_len, dtype=torch.int32)
+            .unsqueeze(0).expand(self.max_batch_size, -1).contiguous()
+        )
+        self.n_inject = n_inject
+        self.n_target_layers = n_target_layers
+        # The graph takes block embeddings, not token ids -- the table is not in it. Keep a
+        # reference so calibration can do the lookup the runtime does on the host.
+        self._embedding = embedding
+        blob = torch.load(hidden_dump, weights_only=False)
+        self._hidden = blob["hidden"] if isinstance(blob, dict) else blob
+        self._cursor = 0
+        self._cache_pos = 0   # how much of the calibration cache holds real values
+        self._mask_token_id = mask_token_id
+
+    def _embed(self, ids: torch.Tensor) -> torch.Tensor:
+        if self._embedding is None:
+            raise RuntimeError(
+                "DFlashDecoderInference needs the embedding table: the graph takes block "
+                "embeddings, so calibration has to look the ids up itself."
+            )
+        return self._embedding(ids).float()
+
+    def _next_hidden(self) -> List[torch.Tensor]:
+        """Take the next n_inject rows of the dump, split per target layer.
+
+        Wraps around rather than stopping: calibration wants coverage of the distribution, and the
+        loop runs for as many steps as the dataset dictates, not as many rows as were dumped.
+        """
+        n, total = self.n_inject, self._hidden.shape[0]
+        idx = (torch.arange(n) + self._cursor) % total
+        self._cursor = (self._cursor + n) % total
+        rows = self._hidden[idx].unsqueeze(0)                       # [1, n, dim*n_target_layers]
+        dim = rows.shape[-1] // self.n_target_layers
+        return [rows[..., i * dim:(i + 1) * dim].contiguous()
+                for i in range(self.n_target_layers)]
+
+    def make_forward_fn(self) -> Callable:
+        """Calibrate the way the graph will actually run: with a cache that fills up.
+
+        The base loop hands the model the same zero-filled cache on every call, which is right for a
+        decoder whose CALIBRATE graph swallows the whole context at once and never reads one. A draft
+        head reads its cache on every step after the first, and the encodings collected here are
+        copied onto the DECODE and PREFILL graphs -- so calibrating against an empty cache sets the
+        quantization parameters for a tensor that was never observed. The symptom is a run that is
+        exactly right on step 0 and falls apart on step 1.
+
+        So the committed rows this call produces are written back into the cache, the position cursor
+        advances, and the mask opens the part of the cache that now holds real values.
+        """
+        n_inject, nxt = self.n_inject, self._next_hidden
+        self_ref = self
+
+        def _forward(model, model_inputs: dict) -> torch.Tensor:
+            k, v = self_ref._k_caches, self_ref._v_caches
+            pos = self_ref.pos_ids
+            cache_len = k[0].shape[-1] if len(k) else 0
+            cur = self_ref._cache_pos
+
+            input_ids = model_inputs["input_ids"]
+            ar_len = input_ids.shape[-1]
+            # Calibrate the block the way it is actually decoded: one real token followed by mask
+            # tokens. The dataset hands over a run of ordinary text, but a diffusion-style draft
+            # never sees that -- every step it gets [id_last, mask, mask, ...] and denoises the
+            # masked positions in parallel. Feeding real text here freezes activation scales for a
+            # distribution that does not occur in deployment, and the observers cannot be re-fit
+            # later: their encodings are copied straight onto the DECODE and PREFILL graphs.
+            if self_ref._mask_token_id is not None:
+                blk = torch.full_like(input_ids, self_ref._mask_token_id)
+                blk[:, 0] = input_ids[:, 0]
+                input_ids = blk
+            pos_ctx = pos[:, cur:cur + n_inject]
+            pos_blk = pos[:, cur + n_inject:cur + n_inject + ar_len]
+
+            masks = []
+            for m in model_inputs["attention_mask"]:
+                m = m.clone()
+                m[..., :cache_len] = PADDING_MASK_VALUE          # close the whole cache, then
+                if cur > 0:
+                    m[..., :cur] = 0                             # reopen only what has been written
+                m[..., cache_len:cache_len + n_inject] = 0       # this step's committed rows
+                masks.append(m)
+
+            out = model(*nxt(), self_ref._embed(input_ids), *masks, pos_blk, pos_ctx, *k, *v)
+
+            # write the committed rows back, exactly as the runtime does
+            if isinstance(out, (tuple, list)) and len(out) > 1 and cache_len:
+                tail = list(out[1:])
+                flat = []
+                for x in tail:
+                    flat.extend(x) if isinstance(x, (list, tuple)) else flat.append(x)
+                half = len(flat) // 2
+                room = min(n_inject, cache_len - cur)
+                if room > 0:
+                    for i in range(half):
+                        k[i][..., cur:cur + room] = flat[i][..., :room].detach()
+                        v[i][:, :, cur:cur + room, :] = flat[half + i][:, :, :room, :].detach()
+                self_ref._cache_pos = (cur + room) % max(1, cache_len - n_inject)
+
+            return out[0] if isinstance(out, (tuple, list)) else out
+
+        return _forward
+
+    @torch.no_grad()
+    def predict_step(self, module, input_ids, attn_mask=None, hidden_states=(), tok_embedding=None):
+        mask = attn_mask if attn_mask is not None else self._default_attn_mask
