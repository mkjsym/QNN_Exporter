+class Qwen3_4B_SqnrQuantRecipe(StaticLLMQuantRecipe):
+    """Qwen3_4BQuantRecipe plus the mixed-precision upgrades suggested by the SQNR analyzer.
+
+    Produced by `--quant_recipe_suggestion` on the 39-sample Spec-Bench calibration set
+    (see qwen3-4b-kv16_quantization_error.csv), keeping the block-16 LPBQ base so this
+    differs from Qwen3_4BQuantRecipe in exactly one way: 13 layer groups move from 4-bit
+    LPBQ to 8-bit per-channel. Costs ~544 MiB of weights (+18% on the .pte).
+
+    The analyzer's SQNR is measured end-to-end on the fully quantized graph, so error
+    propagates forward and the ranking is confounded with depth -- a deep group scoring
+    low may just sit downstream of a fragile one. Within a depth band the ordering still
+    separates w2/wv/wo from w1/w3/wq/wk, which is why this is worth measuring rather than
+    trusting. Judge it on acceptance length, not on SQNR.
+
+    Keeps annotate_kv_8bit: the 13-category sweep put the 8-bit KV cache ahead of 16-bit
+    (AL 1.955 vs 1.925 at 12% higher tps), and it makes ctx_cal the one-variable control.
+    """
+
+    default_quant_dtype = QuantDtype.use_16a4w
+
+    # Upgraded to 16a8w per-channel. Layer lists are the analyzer's depth buckets
+    # (36 // 5 = 7 layers each, remainder folded into the last).
+    _SENSITIVE = (
+        # every down_proj -- the worst group at every depth
+        (range(0, 36), "feed_forward", "w2"),
+        (range(7, 36), "attention", "wv"),
+        (range(21, 36), "attention", "wo"),
+        (range(7, 14), "feed_forward", "w3"),
+    )
+
+    def __init__(self, verbose: bool = False):
+        super().__init__()
+
+        self.recipe = QuantRecipe(
+            self.default_quant_dtype,
+            False,
+            act_observer=MinMaxObserver,
+            granularity=QuantGranularity.PER_TENSOR,
+            verbose=verbose,
+        ).add_node_target(
+            {
+                torch.ops.aten.conv2d.default,
+            },
+            QuantDtype.use_16a4w_block,
+            False,
+            act_observer=MinMaxObserver,
+            granularity=QuantGranularity.PER_BLOCK,
+            extra_kwargs={"block_size": (1, 16, 1, 1)},
+        )
+
+        # Strategies are matched last-added-first, so the regexes below override the
+        # blanket conv2d rule above.
+        for layers, submodule, proj in self._SENSITIVE:
+            ids = "|".join(str(i) for i in layers)
+            self.recipe.add_regex(
+                {
+                    rf"layers\.({ids})\.{submodule}\.forward\.__self__\.{proj}_conv",
+                },
+                QuantDtype.use_16a8w,
+                False,
+                act_observer=MinMaxObserver,
+                granularity=QuantGranularity.PER_CHANNEL,
+                note=f"SqnrAnalyzer: {proj}_conv layers {layers.start}-{layers.stop - 1}",
+            )
+
+        self.recipe.add_regex(
+            {
+                r"output\.conv",
+            },
+            QuantDtype.use_16a8w,
+            False,
+            act_observer=MinMaxObserver,
+            granularity=QuantGranularity.PER_CHANNEL,
+        )
+        self.recipe.custom_quant_annotations.append(annotate_kv_8bit)
+
