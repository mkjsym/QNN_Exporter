--- /dev/null
+++ b/examples/qualcomm/oss_scripts/llama/dump_target_hidden.py
@@ -0,0 +1,85 @@
+#!/usr/bin/env python3
+"""Dump the target hidden states a DFlash draft is quantized against.
+
+Every other model in this pipeline is calibrated by feeding it tokens. A DFlash draft cannot be:
+its input is not an embedding table lookup, it is the target model's hidden states at five layers,
+concatenated. Feed it token embeddings during calibration and the observers on `fc` learn the wrong
+range entirely -- and `fc` is the tensor everything downstream reads.
+
+So the ranges have to come from the target actually running. This dumps them once, offline, in
+bf16, and the draft export replays the dump.
+
+    python dump_target_hidden.py --target Qwen/Qwen3-8B --calib calib.json --out hidden_8b.pt
+
+The layer indices are the DFlash convention: `target_layer_ids` names decoder layers, and
+extract_context_feature reads `hidden_states[layer_id + 1]` because HuggingFace puts the embedding
+output at index 0. For Qwen3 that makes [1,9,17,25,33] into hidden_states indices [2,10,18,26,34] --
+the same five tensors the QNN target already exposes at its shard boundaries, which is not a
+coincidence: the boundaries were chosen to land there.
+"""
+
+import argparse
+import json
+
+import torch
+from transformers import AutoModelForCausalLM, AutoTokenizer
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--target", required=True, help="HF repo id or local path of the TARGET model")
+    ap.add_argument("--calib", required=True, help="JSON file: a list of prompt strings")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--layer-ids", default="1,9,17,25,33")
+    ap.add_argument("--max-len", type=int, default=512)
+    ap.add_argument("--limit", type=int, default=0, help="cap the number of prompts (0 = all)")
+    args = ap.parse_args()
+
+    layer_ids = [int(x) for x in args.layer_ids.split(",")]
+    raw = json.load(open(args.calib))
+    if isinstance(raw, dict):
+        raw = raw.get("prompts", list(raw.values()))
+    if args.limit:
+        raw = raw[: args.limit]
+
+    tok = AutoTokenizer.from_pretrained(args.target)
+
+    # The runtime always applies the chat template (DFLASH_CHAT=1), and templating moves the
+    # activations enough to matter -- on raw prompts several Spec-Bench categories degenerate into
+    # repetition loops. Calibrate on what the model will actually see.
+    def render(item):
+        if isinstance(item, str):
+            return item
+        msgs = item["messages"] if "messages" in item else item
+        return tok.apply_chat_template(
+            msgs, tokenize=False, add_generation_prompt=True, enable_thinking=False
+        )
+
+    prompts = [render(p) for p in raw]
+    model = AutoModelForCausalLM.from_pretrained(
+        args.target, dtype=torch.bfloat16, device_map="cpu"
+    ).eval()
+
+    chunks = []
+    with torch.no_grad():
+        for i, p in enumerate(prompts):
+            ids = tok(p, return_tensors="pt", truncation=True, max_length=args.max_len,
+                      add_special_tokens=False).input_ids
+            out = model(ids, output_hidden_states=True, use_cache=False)
+            # [1, seq, dim*len(layer_ids)] -- same concat order the draft's fc expects
+            h = torch.cat([out.hidden_states[j + 1] for j in layer_ids], dim=-1)
+            chunks.append(h[0].to(torch.float32))
+            print(f"  [{i + 1}/{len(prompts)}] {ids.shape[1]:4d} tokens -> {tuple(h.shape[1:])}")
+
+    stacked = torch.cat(chunks, dim=0)
+    torch.save({"hidden": stacked, "layer_ids": layer_ids, "target": args.target}, args.out)
+    a = stacked.abs()
+    print(f"\nwrote {args.out}: {tuple(stacked.shape)}")
+    print(f"  range [{stacked.min():.3f}, {stacked.max():.3f}]  "
+          f"mean|x| {a.mean():.4f}  p99.9 {a.flatten().kthvalue(int(a.numel() * 0.999))[0]:.3f}")
+    print("  If the max is far above p99.9 the export's min/max observers will spend most of the "
+          "range on outliers -- worth knowing before blaming the draft for a low acceptance length.")
+
+
+if __name__ == "__main__":
+    main()
