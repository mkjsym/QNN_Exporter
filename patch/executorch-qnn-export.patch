--- /dev/null
+++ b/examples/models/qwen3_dflash/convert_weights.py
@@ -0,0 +1,101 @@
+"""Convert a DFlash draft checkpoint to the static-decoder parameter naming.
+
+A DFlash draft is a 5-layer Qwen3 decoder plus two tensors an ordinary decoder does not have:
+`fc`, which projects the concatenated target hidden states down to one hidden width, and
+`hidden_norm`, which normalizes that projection. Both keep their names -- DFlashDraftModel declares
+them under exactly these attributes.
+
+The checkpoint also ships `embed_tokens.weight` and `lm_head.weight`, which the reference draft
+model does not own (it takes the block embedding ready-made and returns un-projected hidden states).
+They are kept here because the fused export does the embedding lookup and the output projection
+inside the graph -- doing either on the host would mean a second device round-trip per step, which
+is the cost this whole exercise exists to remove. The embedding is bit-identical to the target's, so
+nothing is lost by carrying the draft's copy.
+"""
+
+import argparse
+import os
+from typing import Dict
+
+import torch
+
+from executorch.examples.models.qwen3.convert_weights import load_checkpoint
+
+_DFLASH_FROM_HF = {
+    "embed_tokens.weight": "tok_embeddings.weight",
+    "lm_head.weight": "output.weight",
+    "norm.weight": "norm.weight",
+    "hidden_norm.weight": "hidden_norm.weight",
+}
+
+_DFLASH_LAYER_FROM_HF = {
+    "self_attn.q_proj.weight": "attention.wq.weight",
+    "self_attn.k_proj.weight": "attention.wk.weight",
+    "self_attn.v_proj.weight": "attention.wv.weight",
+    "self_attn.o_proj.weight": "attention.wo.weight",
+    "self_attn.q_norm.weight": "attention.q_norm_fn.weight",
+    "self_attn.k_norm.weight": "attention.k_norm_fn.weight",
+    "input_layernorm.weight": "attention_norm.weight",
+    "post_attention_layernorm.weight": "ffn_norm.weight",
+    # Qwen3 applies the activation on gate_proj, so the static decoder's w1/w3 are swapped
+    # relative to the usual w1=up convention -- same swap the Qwen3 converter documents.
+    "mlp.gate_proj.weight": "feed_forward.w1.weight",
+    "mlp.down_proj.weight": "feed_forward.w2.weight",
+    "mlp.up_proj.weight": "feed_forward.w3.weight",
+}
+
+
+# Heads a DSpark checkpoint carries that never enter the graph. DSpark is a DFlash draft plus a
+# Markov head, which re-scores candidates per concrete parent, and a confidence head, which gates
+# proposal length -- both are consumed on the host from the draft GGUF, so the exported graph must
+# not carry them. Dropping them here is what lets one converter serve both drafts.
+_HOST_SIDE_PREFIXES = ("markov_head.", "confidence_head.")
+
+
+def dflash_hf_to_meta(state_dict: Dict[str, torch.Tensor]) -> Dict[str, torch.Tensor]:
+    out = {}
+    for key, value in state_dict.items():
+        if key.startswith(_HOST_SIDE_PREFIXES):
+            continue
+        if key == "fc.weight":
+            # Split the projection into one block per target layer. The model sums the blocks
+            # instead of projecting a concatenation, so that each target layer keeps its own
+            # activation scale -- see dflash_draft.py for why that matters.
+            dim = value.shape[0]
+            n = value.shape[1] // dim
+            assert value.shape[1] == dim * n, f"fc is not a whole number of blocks: {value.shape}"
+            for i in range(n):
+                out[f"fc.{i}.weight"] = value[:, i * dim:(i + 1) * dim].contiguous()
+            continue
+        if key in _DFLASH_FROM_HF:
+            out[_DFLASH_FROM_HF[key]] = value
+            continue
+        if key.startswith("layers."):
+            idx, rest = key.split(".", 2)[1], key.split(".", 2)[2]
+            if rest in _DFLASH_LAYER_FROM_HF:
+                out[f"layers.{idx}.{_DFLASH_LAYER_FROM_HF[rest]}"] = value
+                continue
+        raise KeyError(f"unmapped DFlash tensor: {key}")
+    return out
+
+
+def convert_weights(input_dir: str, output_file: str) -> None:
+    print("Loading checkpoint...")
+    sd = load_checkpoint(input_dir)
+    print("Converting checkpoint...")
+    sd = dflash_hf_to_meta(sd)
+    print(f"Saving checkpoint to {output_file}...")
+    torch.save(sd, output_file)
+    print("Done.")
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Convert a DFlash draft checkpoint.")
+    parser.add_argument("input_dir", type=str, help="Directory holding the DFlash checkpoint.")
+    parser.add_argument("output", type=str, help="Path to the output checkpoint.")
+    args = parser.parse_args()
+    convert_weights(args.input_dir, args.output)
+
+
+if __name__ == "__main__":
+    main()
