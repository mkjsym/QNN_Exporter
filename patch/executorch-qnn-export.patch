+class Qwen3_KV16HistQuantRecipe(StaticLLMQuantRecipe):
+    """KV16 with histogram-based activation ranges instead of min/max.
+
+    MinMaxObserver takes the extremes it happens to see during calibration, so a handful of outlier
+    activations set the scale and the bulk of the distribution gets a fraction of the range. Measured
+    on the exported model, the inter-shard hidden tensors carry a span of ~20,700 where a real prompt
+    only spans ~5,800 -- 3.5x wider than needed. HistogramObserver picks the range that minimises
+    quantization error over the observed distribution instead, which is the direct fix for that.
+
+    Weights keep their min/max observers; only activations change. Costs calibration time only.
+    """
+    default_quant_dtype = QuantDtype.use_16a4w
+
+    def __init__(self, verbose: bool = False):
+        super().__init__()
+
+        self.recipe = (
+            QuantRecipe(
+                self.default_quant_dtype,
+                False,
+                act_observer=HistogramObserver,
+                granularity=QuantGranularity.PER_TENSOR,
+                verbose=verbose,
+            )
+            .add_node_target(
+                {
+                    torch.ops.aten.conv2d.default,
+                },
+                QuantDtype.use_16a4w_block,
+                False,
+                act_observer=HistogramObserver,
+                granularity=QuantGranularity.PER_BLOCK,
+                extra_kwargs={"block_size": (1, 16, 1, 1)},
+            )
+            .add_regex(
+                {
+                    r"output\.conv",
+                },
+                QuantDtype.use_16a8w,
+                False,
+                act_observer=HistogramObserver,
+                granularity=QuantGranularity.PER_CHANNEL,
+            )
+        )
+        # no annotate_kv_8bit: keep the KV cache at 16 bits (see Qwen3_KV16QuantRecipe)
