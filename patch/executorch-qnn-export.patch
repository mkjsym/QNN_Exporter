+class Qwen3_KV16QuantRecipe(StaticLLMQuantRecipe):
+    """16a4w with a 16-bit KV cache instead of 8-bit.
+
+    Identical to Qwen3_4BQuantRecipe except that annotate_kv_8bit is not applied, which leaves the
+    KV cache at 16 bits (see StaticLLMQuantRecipe.get_kv_io_bit_width).
+
+    Why: the GPU baseline reaches acceptance length 2.79 with 4-bit weights, while this NPU target
+    reaches 1.65. Weight precision is not the difference -- the weight matrices here are 4-bit over
+    blocks of 16, finer than q4_0's blocks of 32, and raising them to 8 bits changed nothing. The KV
+    cache is: llama.cpp keeps it at f16, this recipe stores it as UFIXED_POINT_8. Measured on the
+    exported model the K cache carries scale 0.060, i.e. 256 levels across a span of ~15, so every
+    past key is ~1% noisy. Attention reads the entire context through that, and a target whose
+    attention has drifted disagrees with a draft trained against the bf16 target.
+
+    Costs 2x KV memory (72 -> 144 MiB at 1024 context) and 2x KV bandwidth per verify.
+    """
+    default_quant_dtype = QuantDtype.use_16a4w
+
+    def __init__(self, verbose: bool = False):
+        super().__init__()
+
+        self.recipe = (
+            QuantRecipe(
+                self.default_quant_dtype,
+                False,
+                act_observer=MinMaxObserver,
+                granularity=QuantGranularity.PER_TENSOR,
+                verbose=verbose,
+            )
+            .add_node_target(
+                {
+                    torch.ops.aten.conv2d.default,
+                },
+                QuantDtype.use_16a4w_block,
+                False,
+                act_observer=MinMaxObserver,
