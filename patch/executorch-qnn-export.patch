--- /dev/null
+++ b/examples/models/qwen3_eagle3/convert_weights.py
@@ -0,0 +1,102 @@
+"""Convert an EAGLE-3 draft checkpoint to the static-decoder parameter naming.
+
+An EAGLE-3 draft is one decoder layer under the name `midlayer`, plus three tensors an ordinary
+decoder does not have: `fc`, which projects three concatenated target hidden states down to one
+hidden width; `midlayer.hidden_norm`, which normalizes that projection; and `d2t`, which maps the
+reduced draft vocabulary back onto the target's.
+
+`d2t` and its inverse `t2d` are dropped here on purpose. They are a host-side lookup -- the driver
+already reads them from the draft GGUF and applies them to the handful of ids that survive top-k --
+and putting them in the graph would widen the output projection from 32000 to 151936 for no gain.
+
+The checkpoint has no `embed_tokens`: an EAGLE-3 draft borrows the target's table. The exported
+graph takes ready embeddings for the same reason the DFlash one does, so nothing has to be
+synthesized here.
+"""
+
+import argparse
+from typing import Dict
+
+import torch
+
+from executorch.examples.models.qwen3.convert_weights import load_checkpoint
+
+_EAGLE3_FROM_HF = {
+    "lm_head.weight": "output.weight",
+    "norm.weight": "norm.weight",
+    "midlayer.hidden_norm.weight": "layers.0.hidden_norm.weight",
+    "midlayer.input_layernorm.weight": "layers.0.attention_norm.weight",
+    "midlayer.post_attention_layernorm.weight": "layers.0.ffn_norm.weight",
+    "midlayer.self_attn.q_proj.weight": "layers.0.attention.wq.weight",
+    "midlayer.self_attn.k_proj.weight": "layers.0.attention.wk.weight",
+    "midlayer.self_attn.v_proj.weight": "layers.0.attention.wv.weight",
+    "midlayer.self_attn.o_proj.weight": "layers.0.attention.wo.weight",
+    # Qwen3 applies the activation on gate_proj, so the static decoder's w1/w3 are swapped
+    # relative to the usual w1=up convention -- same swap the Qwen3 converter documents.
+    "midlayer.mlp.gate_proj.weight": "layers.0.feed_forward.w1.weight",
+    "midlayer.mlp.down_proj.weight": "layers.0.feed_forward.w2.weight",
+    "midlayer.mlp.up_proj.weight": "layers.0.feed_forward.w3.weight",
+}
+
+# vocabulary maps the host applies after top-k; see the module docstring
+_HOST_SIDE = ("d2t", "t2d")
+
+
+def eagle3_hf_to_meta(state_dict: Dict[str, torch.Tensor]) -> Dict[str, torch.Tensor]:
+    out = {}
+    for key, value in state_dict.items():
+        if key in _HOST_SIDE:
+            continue
+        if key == "fc.weight":
+            # Split the projection into one block per target layer. The model sums the blocks
+            # instead of projecting a concatenation, so each target layer keeps its own activation
+            # scale -- see eagle3_draft.py for why that matters.
+            dim = value.shape[0]
+            n = value.shape[1] // dim
+            assert value.shape[1] == dim * n, f"fc is not a whole number of blocks: {value.shape}"
+            for i in range(n):
+                out[f"fc.{i}.weight"] = value[:, i * dim:(i + 1) * dim].contiguous()
+            continue
+        if key in _EAGLE3_FROM_HF:
+            out[_EAGLE3_FROM_HF[key]] = value
+            continue
+        raise KeyError(f"unmapped EAGLE-3 tensor: {key}")
+    return out
+
+
+def convert_weights(input_dir: str, output_file: str, target_dir: str = None) -> None:
+    print("Loading checkpoint...")
+    sd = load_checkpoint(input_dir)
+    print("Converting checkpoint...")
+    sd = eagle3_hf_to_meta(sd)
+    if target_dir:
+        # The draft borrows the target's embedding table. It is not a graph input -- forward never
+        # touches it, so it is stripped at to_edge -- but calibration has to do the lookup the
+        # runtime does on the host, and dump_draft_embd.py reads it from here to write the fp16
+        # file the device mmaps. Carrying it in this checkpoint keeps both from needing a second
+        # path to the target.
+        tgt = load_checkpoint(target_dir)
+        for key in ("model.embed_tokens.weight", "embed_tokens.weight", "tok_embeddings.weight"):
+            if key in tgt:
+                sd["tok_embeddings.weight"] = tgt[key]
+                print(f"  + tok_embeddings.weight from target ({tuple(tgt[key].shape)})")
+                break
+        else:
+            raise KeyError(f"no embedding table in {target_dir}; have {sorted(tgt)[:6]}...")
+    print(f"Saving checkpoint to {output_file}...")
+    torch.save(sd, output_file)
+    print("Done.")
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Convert an EAGLE-3 draft checkpoint.")
+    parser.add_argument("input_dir", type=str, help="Directory holding the EAGLE-3 checkpoint.")
+    parser.add_argument("output", type=str, help="Path to the output checkpoint.")
+    parser.add_argument("--target-dir", type=str, default=None,
+                        help="Target model directory, to copy its embedding table in.")
+    args = parser.parse_args()
+    convert_weights(args.input_dir, args.output, args.target_dir)
+
+
+if __name__ == "__main__":
+    main()
