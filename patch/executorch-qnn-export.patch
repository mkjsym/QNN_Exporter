@@ -0,0 +1,318 @@
+# Copyright (c) Qualcomm Innovation Center, Inc.
+# All rights reserved
+#
+# This source code is licensed under the BSD-style license found in the
+# LICENSE file in the root directory of this source tree.
+"""EAGLE-3 speculative-decoding draft head.
+
+An EAGLE-3 draft is one decoder layer that predicts what the target will say next. Every row it
+processes carries two things: the embedding of the token at that position, and a hidden state `g`
+describing what the model already knows there. That pairing is the whole architecture, and it is
+what makes this layer unlike an ordinary decoder layer:
+
+    - the two are normed SEPARATELY -- `input_layernorm` on the embedding, `hidden_norm` on `g` --
+      and then CONCATENATED, so Q, K and V are projected from 2*dim rather than dim.
+    - the residual stream is `g`, not the concatenation. The attention output is added to the raw,
+      un-normed `g`; the token embedding contributes only through attention.
+    - there is no q/k norm, unlike the Qwen3 target it drafts for.
+
+`g` has two sources depending on where in a step the row sits, and a static graph has to serve both:
+
+    depth 0 -- the rows the target just committed. `g` is the target's own hidden state, read at
+               three layer boundaries (low/mid/high) and projected down by `fc` (3*dim -> dim).
+    depth d>0 -- the tree frontier. `g` is this layer's own pre-norm output from the parent row, at
+               dim already; `fc` has no part in it.
+
+Rather than branch, the graph computes `g = sum_i fc_i(h_i) + g_direct` and the caller zeroes
+whichever side does not apply. `fc` carries no bias, so `fc(0) = 0` exactly and the sum is the
+identity in both directions -- no selector, no second graph, and the fc pass costs about 10 MB of
+weight streaming (~0.2 ms) on the steps that do not need it.
+
+Splitting `fc` into three per-layer blocks that are summed is the same projection as one 7680-wide
+matmul -- sum_i fc_i(h_i) == fc(cat(h_i)) -- but it gives each target layer its own activation
+scale. That matters here for the same reason it does in the DFlash draft: a Qwen3-4B target's early
+and late hidden states are not on comparable scales, and one 16-bit scale set by the largest would
+round the smallest to zero.
+
+The draft owns no embedding table (the checkpoint has no `embed_tokens`; it borrows the target's),
+so rows arrive as ready embeddings, exactly as they do for DFlash. Its output head is a REDUCED
+vocabulary -- 32000 of the target's 151936 -- with a `d2t` map back. That map is a host-side
+concern: keeping it out of the graph is worth 4.7x on both the output projection and every
+vocabulary scan the host does afterwards.
+"""
+
+from typing import List, Optional, Tuple
+
+import torch
+import torch.nn as nn
+
+from executorch.examples.models.llama.model_args import ModelArgs
+
+from executorch.examples.qualcomm.oss_scripts.llama.masking_utils import (
+    AttentionMask,
+    CausalAttentionMask,
+)
+
+from .static_llama import (
+    LlamaAttention,
+    LlamaDecoderLayer,
+    LlamaModel,
+    NORM_REGISTRY,
+    repeat_kv,
+)
+
+
+class Eagle3Attention(LlamaAttention):
+    """Attention whose Q/K/V read a 2*dim concatenation instead of the hidden state.
+
+    Everything downstream of the projections -- rope, the cache layout, the mask convention -- is
+    the base class's. Only the input width and the absence of q/k norm differ, so this overrides
+    the projection widths in __init__ and reimplements forward without the norm branches.
+    """
+
+    def __init__(self, layer_idx: int, config: ModelArgs, output_new_cache_only=False):
+        super().__init__(layer_idx, config, output_new_cache_only)
+        # the base class sized these for a dim-wide input; EAGLE-3 feeds them [embd_norm | g_norm]
+        self.wq = nn.Linear(2 * self.dim, self.n_heads * self.head_dim, bias=False)
+        self.wk = nn.Linear(2 * self.dim, self.n_kv_heads * self.head_dim, bias=False)
+        self.wv = nn.Linear(2 * self.dim, self.n_kv_heads * self.head_dim, bias=False)
+        assert not self.use_qk_norm, (
+            "the EAGLE-3 draft checkpoints carry no q_norm/k_norm; the config asks for them"
+        )
+
+    def prepare_attention_conv(self):
+        """The base version sizes Q/K/V for a dim-wide input; these read the 2*dim concatenation.
+
+        Everything else is the base class's, including the rebinding of forward and the deletion of
+        the Linear modules once their weights have been copied across.
+        """
+        self.wq_conv = nn.Conv2d(2 * self.dim, self.n_heads * self.head_dim, 1, bias=False)
+        self.wk_conv = nn.Conv2d(2 * self.dim, self.n_kv_heads * self.head_dim, 1, bias=False)
+        self.wv_conv = nn.Conv2d(2 * self.dim, self.n_kv_heads * self.head_dim, 1, bias=False)
+        self.wo_conv = nn.Conv2d(self.n_heads * self.head_dim, self.dim, 1, bias=False)
+
+        self.forward_no_conv = self.forward
+        self.forward = self.forward_attention_conv
+
+        self.wq_conv.weight.data.copy_(self.wq.weight[:, :, None, None])
+        self.wk_conv.weight.data.copy_(self.wk.weight[:, :, None, None])
+        self.wv_conv.weight.data.copy_(self.wv.weight[:, :, None, None])
+        self.wo_conv.weight.data.copy_(self.wo.weight[:, :, None, None])
+
+        del self.wq
+        del self.wk
+        del self.wv
+        del self.wo
+
+    def _forward_impl(
+        self,
+        x: torch.Tensor,                # [b, seq, 2*dim] -- concatenated, already normed
+        freqs_cos: torch.Tensor,
+        freqs_sin: torch.Tensor,
+        atten_mask: torch.Tensor,
+        k_caches: torch.Tensor,
+        v_caches: torch.Tensor,
+        conv: bool,
+    ) -> Tuple[torch.Tensor, List[torch.Tensor], List[torch.Tensor]]:
+        bsz, seq_len, _ = x.shape
+
+        if conv:
+            h = torch.reshape(x, (bsz, seq_len, 1, 2 * self.dim)).transpose(1, 3)
+            q = self.wq_conv(h).permute(0, 3, 1, 2).squeeze(-1)
+            k = self.wk_conv(h).permute(0, 3, 1, 2).squeeze(-1)
+            v = self.wv_conv(h).permute(0, 3, 1, 2).squeeze(-1)
+        else:
+            q, k, v = self.wq(x), self.wk(x), self.wv(x)
+        q = q.view(bsz, seq_len, self.n_heads,    self.head_dim).transpose(1, 2)
+        k = k.view(bsz, seq_len, self.n_kv_heads, self.head_dim).transpose(1, 2)
+        v = v.view(bsz, seq_len, self.n_kv_heads, self.head_dim).transpose(1, 2)
+
+        if self.use_rope:
+            q = self.apply_rope_emb(q, freqs_cos, freqs_sin)
+            k = self.apply_rope_emb(k, freqs_cos, freqs_sin)
+        if getattr(self.config, "enable_r3", False):
+            q = torch.matmul(q, self.r3_weight)
+            k = torch.matmul(k, self.r3_weight)
+        k = k.transpose(2, 3)
+
+        kh = repeat_kv(torch.cat([k_caches, k], dim=-1), self.num_key_value_groups)
+        vh = repeat_kv(torch.cat([v_caches, v], dim=2),  self.num_key_value_groups)
+
+        attn = (q @ kh) / self.scale
+        if self.enable_masked_softmax:
+            attn_min = torch.amin(attn, dim=-1, keepdim=True)
+            attn = torch.where(atten_mask == 0, attn, attn_min + (-20))
+        else:
+            attn = attn + atten_mask
+        attn = self.attn_softmax(attn)
+        y = (attn @ vh).transpose(1, 2)
+        if conv:
+            y = y.reshape(bsz, seq_len, 1, -1).transpose(1, 3)
+            y = self.wo_conv(y).transpose(1, 3).reshape(bsz, seq_len, -1)
+        else:
+            y = self.wo(y.reshape(bsz, seq_len, -1))
+
+        return y, [k], [v]
+
+    def forward(self, x, freqs_cos, freqs_sin, atten_mask, k_caches, v_caches):
+        return self._forward_impl(x, freqs_cos, freqs_sin, atten_mask,
+                                  k_caches, v_caches, conv=False)
+
+    def forward_attention_conv(self, x, freqs_cos, freqs_sin, atten_mask, k_caches, v_caches):
+        return self._forward_impl(x, freqs_cos, freqs_sin, atten_mask,
+                                  k_caches, v_caches, conv=True)
+
+
+class Eagle3DecoderLayer(LlamaDecoderLayer):
+    """The single midlayer: two norms in, concatenate, attend, residual on `g`, then the MLP."""
+
+    def __init__(self, layer_idx: int, config: ModelArgs, output_new_cache_only=False):
+        super().__init__(layer_idx, config, output_new_cache_only)
+        self.attention = Eagle3Attention(
+            layer_idx=layer_idx, config=config, output_new_cache_only=output_new_cache_only
+        )
+        # `attention_norm` (== input_layernorm) is inherited and applies to the token embedding;
+        # this second norm applies to g. The reference calls it hidden_norm.
+        self.hidden_norm = NORM_REGISTRY[config.norm_type](config.dim, eps=config.norm_eps)
+
+    def forward(self, embd, g, freqs_cos, freqs_sin, atten_mask, k_caches, v_caches):
+        x = torch.cat([self.attention_norm(embd), self.hidden_norm(g)], dim=-1)
+        h, k_cache, v_cache = self.attention(
+            x=x,
+            freqs_cos=freqs_cos,
+            freqs_sin=freqs_sin,
+            atten_mask=atten_mask,
+            k_caches=k_caches,
+            v_caches=v_caches,
+        )
+        # the residual is the raw g, not the concatenation and not its normed form
+        h = g + h
+        out = self.feed_forward(self.ffn_norm(h))
+        return h + out, k_cache, v_cache
+
+
+class Eagle3DraftModel(LlamaModel):
+    """One graph call per tree depth: take (embedding, g) rows, return logits and the next g.
+
+    `ar_len` is how many rows one call processes. The driver uses it two ways -- the recompute pass
+    over the tokens the target just committed, and each depth's frontier expansion -- so it is sized
+    for the larger of the two and the caller pads. Padding is close to free on this backend: a call
+    costs what its weights cost to stream, and the rows ride along.
+
+    The pre-norm hidden is returned alongside the logits because the next depth needs it as `g`.
+    Keeping it on the device side of the boundary is the point of exporting the draft at all: the
+    host never has to assemble a 7680-wide feature or round-trip a hidden state.
+    """
+
+    def __init__(self, config: ModelArgs, ar_len=1, output_new_cache_only=True,
+                 output_cache=True, use_i64_token=False, n_e3_layers=3,
+                 target_vocab_size=151936, **kwargs):
+        super().__init__(
+            config=config, ar_len=ar_len, output_new_cache_only=output_new_cache_only,
+            output_cache=output_cache, use_i64_token=use_i64_token, **kwargs
+        )
+        self.n_e3_layers = n_e3_layers
+        # config.vocab_size is the DRAFT vocabulary (32000), which is what the logits tensor is and
+        # therefore what the wrapper matches against to find the output. The embedding table is the
+        # TARGET's, at its own width -- the draft owns no table and borrows the target's. It never
+        # appears in forward, so it is stripped at to_edge; it is here only so calibration can do
+        # the lookup the runtime does on the host.
+        self.target_vocab_size = target_vocab_size
+        self.tok_embeddings = nn.Embedding(target_vocab_size, config.dim)
+        self.layers = nn.ModuleList(
+            [Eagle3DecoderLayer(i, config, output_new_cache_only) for i in range(config.n_layers)]
+        )
+        assert config.n_layers == 1, (
+            f"an EAGLE-3 draft is a single midlayer; config says {config.n_layers}"
+        )
+        # one block per target layer, summed in forward: sum_i fc_i(h_i) == fc(cat(h_i))
+        self.fc = nn.ModuleList(
+            [nn.Linear(config.dim, config.dim, bias=False) for _ in range(n_e3_layers)]
+        )
+        # reduced-vocabulary head; d2t stays on the host
+
+    def forward(
+        self,
+        h_0: torch.Tensor,
+        h_1: torch.Tensor,
+        h_2: torch.Tensor,
+        g_direct: torch.Tensor,
+        tok_embd: torch.Tensor,
+        atten_mask: torch.Tensor,
+        input_pos: torch.Tensor,
+        *args,
+    ) -> Tuple[torch.Tensor, torch.Tensor, List[torch.Tensor], List[torch.Tensor]]:
+        """Three target hiddens named rather than packed.
+
+        The export pipeline identifies KV cache inputs by placeholder name -- it looks for `args_<i>`
+        and reads <i> as the layer index -- so only the caches may be varargs. Everything in front
+        has to be named, which is also why the count is fixed at three rather than read from
+        n_e3_layers: EAGLE-3 reads exactly three target layers (low, mid, high), and `fc` is built
+        to match.
+        """
+        assert self.n_e3_layers == 3, (
+            f"this forward names three target hidden inputs; config says {self.n_e3_layers}"
+        )
+        target_hidden = [h_0, h_1, h_2]
+
+        freqs_cos = self.freqs_cos[input_pos][0]
+        freqs_sin = self.freqs_sin[input_pos][0]
+
+        # depth 0 supplies target hiddens and a zero g_direct; deeper rows do the reverse. fc has no
+        # bias, so the unused side contributes exactly zero.
+        g = g_direct
+        for fc_i, h_i in zip(self.fc, target_hidden):
+            g = g + fc_i(h_i)
+
+        output_k_cache = []
+        output_v_cache = []
+        hidden_states = None
+        for ind, decoder_layer in enumerate(self.layers):
+            hidden_states, k, v = decoder_layer(
+                tok_embd,
+                g,
+                freqs_cos=freqs_cos,
+                freqs_sin=freqs_sin,
+                atten_mask=atten_mask,
+                k_caches=args[ind],
+                v_caches=args[self.n_layers + ind],
+            )
+            output_k_cache.extend(k)
+            output_v_cache.extend(v)
+
+        logits = self.output(self.norm(hidden_states))
+        if self.logits_scaling:
+            logits = logits / self.logits_scaling
+        if self.output_cache:
+            return logits, hidden_states, output_k_cache, output_v_cache
+        return logits, hidden_states
+
+    def get_example_inputs(self):
+        b = self.max_batch_size
+        target_hidden = [
+            torch.randn((b, self.ar_len, self.dim), dtype=torch.float32)
+            for _ in range(self.n_e3_layers)
+        ]
+        g_direct = torch.randn((b, self.ar_len, self.dim), dtype=torch.float32)
+        tok_embd = torch.randn((b, self.ar_len, self.dim), dtype=torch.float32)
+        cache_len = self.max_context_len - self.ar_len
+        atten_mask = AttentionMask(
+            CausalAttentionMask(b, self.ar_len, self.max_context_len)
+        )
+        pos = torch.zeros((b, self.ar_len), dtype=torch.int32)
+        k_cache, v_cache = [], []
+        for _ in range(self.n_layers):
+            k_cache.append(torch.zeros(b, self.n_kv_heads, self.head_dim, cache_len))
+            v_cache.append(torch.zeros(b, self.n_kv_heads, cache_len, self.head_dim))
+        # Nested, in the shape the wrapper's export_input builder indexes positionally; the model
+        # itself takes the flattened version that builder produces.
+        return (target_hidden + [g_direct], tok_embd, atten_mask, pos, k_cache, v_cache)
+
+    def get_attn_mask_template(self):
+        return self.get_example_inputs()[2]
+
+    def get_metadata(self):
+        meta = super().get_metadata()
+        meta["n_e3_layers"] = self.n_e3_layers
+        meta["target_vocab_size"] = self.target_vocab_size
+        return meta
