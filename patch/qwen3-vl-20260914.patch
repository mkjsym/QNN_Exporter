+"""Calibrate on actual mtmd image embeddings and DeepStack features.
+
+Each calibration sample replays one complete fixture, chunking exactly like the
+runtime and retaining KV only within that prompt. Token-only calibration is refused.
+"""
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from executorch.examples.qualcomm.oss_scripts.llama.masking_utils import PADDING_MASK_VALUE
+
+
+class Qwen3VLDecoderInference:
+    def __init__(self, get_example_inputs, fixtures):
+        if not fixtures:
+            raise ValueError("Qwen3-VL requires --vlm_calibration with real image fixture JSON files")
+        ex = get_example_inputs()
+        if len(ex) != 9 or ex[0].shape[0] != 1:
+            raise ValueError("Qwen3-VL calibration requires a batch-1 explicit multimodal interface")
+        self.ar_len, self.dim = ex[0].shape[1:]
+        self._default_attn_mask, self._k, self._v = ex[1], ex[-2], ex[-1]
+        self._fixtures = []
+        for name in fixtures:
+            path = Path(name)
+            meta = json.loads(path.read_text())
+            if meta.get("format_version") != 1 or meta.get("dim") != self.dim or meta.get("image_rows", 0) <= 0:
+                raise ValueError(f"not a Qwen3-VL image fixture: {path}")
+            prefix = path.with_suffix("")
+            values = []
+            for role in ("vlm_embd", "vlm_rope_cos", "vlm_rope_sin", "vlm_deepstack_0", "vlm_deepstack_1", "vlm_deepstack_2"):
+                dim = 64 if "rope" in role else self.dim
+                data = np.fromfile(str(prefix) + f".{role}.f32", dtype="<f4")
+                if data.size != meta["rows"] * dim or not np.isfinite(data).all():
+                    raise ValueError(f"malformed fixture tensor: {prefix}.{role}")
+                values.append(torch.from_numpy(data.reshape(meta["rows"], dim)))
+            if meta["rows"] > self._k[0].shape[-1]:
+                raise ValueError("fixture exceeds this graph's persistent KV capacity")
+            self._fixtures.append(values)
+        self._cursor = 0
+
+    def _inputs(self, fixture, offset, keys, values):
+        n = min(self.ar_len, fixture[0].shape[0] - offset)
+        data = []
+        for j, tensor in enumerate(fixture):
+            padded = torch.full((self.ar_len, tensor.shape[1]), 1.0 if j == 1 else 0.0)
+            padded[:n] = tensor[offset:offset + n]
+            data.append(padded if j in (1, 2) else padded.unsqueeze(0))
+        cache_len = keys[0].shape[-1]
+        mask = torch.full((1, 1, self.ar_len, cache_len + self.ar_len), PADDING_MASK_VALUE)
+        mask[..., :offset] = 0
+        for row in range(self.ar_len):
+            mask[..., row, cache_len:cache_len + min(row + 1, n)] = 0
+        return (data[0], mask, *data[1:], *keys, *values), n
+
+    def make_forward_fn(self):
+        def forward(model, model_inputs):
+            fixture = self._fixtures[self._cursor % len(self._fixtures)]
+            self._cursor += 1
+            keys, values = [torch.zeros_like(k) for k in self._k], [torch.zeros_like(v) for v in self._v]
+            logits = []
+            for offset in range(0, fixture[0].shape[0], self.ar_len):
+                args, n = self._inputs(fixture, offset, keys, values)
+                out = model(*args)
+                logits.append(out[0][:, :n])
+                flat = []
+                for item in out[1:]:
+                    flat.extend(item) if isinstance(item, (tuple, list)) else flat.append(item)
+                half = len(flat) // 2
+                if half != len(keys):
+                    raise ValueError("Qwen3-VL calibration KV output count mismatch")
+                for i in range(half):
+                    keys[i][..., offset:offset + n] = flat[i][..., :n].detach()
+                    values[i][..., offset:offset + n, :] = flat[half + i][..., :n, :].detach()
+            return torch.cat(logits, dim=1)
+        return forward
+
+    @torch.no_grad()
+    def predict_step(self, module, input_ids, attn_mask=None, hidden_states=(), tok_embedding=None):
+        # PTQStrategy calls predict_step, so replay the complete image prefix here too.
+        return self.make_forward_fn()(module, {"input_ids": input_ids})
