new file mode 100644
--- /dev/null
+++ b/examples/qualcomm/oss_scripts/llama/model/qwen3_vl.py
@@ -0,0 +1,129 @@
+# Copyright (c) Qualcomm Innovation Center, Inc.
+# All rights reserved.
+# Licensed under the BSD-style license in the root LICENSE file.
+
+"""Qwen3-VL text decoder with explicit embedding, DeepStack and rotary inputs.
+
+The vision encoder runs separately. Sequence-order attention masks and physical KV
+slots never use the compressed multimodal rotary coordinates.
+"""
+
+import re
+
+import numpy as np
+import torch
+
+from executorch.examples.qualcomm.oss_scripts.llama.model.static_llama import (
+    LlamaDecoderLayer,
+    LlamaModel,
+    LlamaModelWithoutEmbedding,
+)
+
+
+def interleaved_mrope(positions: torch.Tensor, head_dim=128, theta=5_000_000.0):
+    """positions: [rows, 3] in time/height/width order; output: [rows, 64]."""
+    if head_dim != 128 or theta != 5_000_000.0:
+        raise ValueError("Qwen3-VL-4B requires head_dim=128, theta=5e6")
+    if positions.ndim != 2 or positions.shape[1] != 3:
+        raise ValueError("expected [rows,3] rotary coordinates")
+    freq = torch.arange(head_dim // 2, device=positions.device)
+    axes = torch.where(freq < 60, freq % 3, 0)
+    angles = positions[:, axes].float() * theta ** (-2.0 * freq.float() / head_dim)
+    return angles.cos(), angles.sin()
+
+
+class Qwen3VLDecoderLayer(LlamaDecoderLayer):
+    def forward(self, x, freqs_cos, freqs_sin, atten_mask, k_caches=None, v_caches=None,
+                deepstack=None):
+        hidden, k, v = super().forward(x, freqs_cos, freqs_sin, atten_mask, k_caches, v_caches)
+        # Keep the addition in this layer's scope: the shard boundary must capture AFTER DeepStack.
+        return (hidden + deepstack if deepstack is not None else hidden), k, v
+
+
+class Qwen3VLTargetModel(LlamaModelWithoutEmbedding):
+    is_qwen3_vl = True
+    decoder_layer_class = Qwen3VLDecoderLayer
+
+    def forward(self, vlm_embd, atten_mask, vlm_rope_cos, vlm_rope_sin,
+                vlm_deepstack_0, vlm_deepstack_1, vlm_deepstack_2, *args):
+        hidden = vlm_embd
+        deepstack = (vlm_deepstack_0, vlm_deepstack_1, vlm_deepstack_2)
+        keys, values = [], []
+        for i, layer in enumerate(self.layers):
+            hidden, k, v = layer(
+                hidden, freqs_cos=vlm_rope_cos, freqs_sin=vlm_rope_sin,
+                atten_mask=atten_mask,
+                k_caches=args[i] if self.use_kv_cache else None,
+                v_caches=args[self.n_layers + i] if self.use_kv_cache else None,
+                deepstack=deepstack[i] if i < 3 else None,
+            )
+            keys.extend(k)
+            values.extend(v)
+        logits = self.output(self.norm(hidden))
+        return (logits, keys, values) if self.output_cache else logits
+
+    def get_example_inputs(self):
+        if not self.use_kv_cache:
+            raise ValueError("Qwen3-VL export requires the explicit KV interface")
+        # The embedding-free base uses max_seq_len for caches; QNN IO metadata uses
+        # max_context_len. Keep the actual tensors aligned with the metadata.
+        _, mask, _, keys, values = LlamaModel.get_example_inputs(self)
+        embd = torch.zeros(self.max_batch_size, self.ar_len, self.dim)
+        cos = torch.ones(self.ar_len, self.head_dim // 2)
+        sin = torch.zeros_like(cos)
+        return embd, mask, cos, sin, *(torch.zeros_like(embd) for _ in range(3)), keys, values
+
+    def get_metadata(self):
+        return {**super().get_metadata(), "qwen3_vl_input_version": 1, "n_deepstack": 3}
+
+
+def load_qwen3_vl_gguf(path):
+    """Load an unquantized GGUF in RAM, avoiding a second 16 GB FP32 checkpoint.
+
+    Qwen3 GGUF conversion preserves HF Q/K split-half ordering. Only names change.
+    Quantized target checkpoints are rejected so export calibration starts from BF16/F16.
+    """
+    import gguf
+
+    reader = gguf.GGUFReader(path)
+    def field(key):
+        if key not in reader.fields:
+            raise ValueError(f"missing GGUF metadata: {key}")
+        return reader.fields[key].contents()
+    expected = {
+        "general.architecture": "qwen3vl",
+        "qwen3vl.embedding_length": 2560,
+        "qwen3vl.block_count": 36,
+        "qwen3vl.rope.freq_base": 5_000_000.0,
+        "qwen3vl.rope.dimension_sections": [24, 20, 20, 0],
+    }
+    for key, value in expected.items():
+        if field(key) != value:
+            raise ValueError(f"incompatible Qwen3-VL-4B metadata: {key}")
+    names = {
+        "attn_q": "attention.wq", "attn_k": "attention.wk",
+        "attn_v": "attention.wv", "attn_output": "attention.wo",
+        "attn_q_norm": "attention.q_norm_fn", "attn_k_norm": "attention.k_norm_fn",
+        "attn_norm": "attention_norm", "ffn_norm": "ffn_norm",
+        "ffn_gate": "feed_forward.w1", "ffn_down": "feed_forward.w2", "ffn_up": "feed_forward.w3",
+    }
+    top = {"token_embd.weight": "tok_embeddings.weight", "output_norm.weight": "norm.weight",
+           "output.weight": "output.weight"}
+    result = {}
+    for tensor in reader.tensors:
+        match = re.fullmatch(r"blk\.(\d+)\.(\w+)\.weight", tensor.name)
+        if tensor.name in top:
+            key = top[tensor.name]
+        elif match and match[2] in names:
+            key = f"layers.{match[1]}.{names[match[2]]}.weight"
+        else:
+            raise ValueError(f"unmapped target tensor: {tensor.name}")
+        if tensor.tensor_type not in (gguf.GGMLQuantizationType.F32, gguf.GGMLQuantizationType.F16,
+                                      gguf.GGMLQuantizationType.BF16):
+            raise ValueError(f"export requires unquantized weights: {tensor.name}")
+        array = gguf.quants.dequantize(tensor.data, tensor.tensor_type)
+        result[key] = torch.from_numpy(np.array(array, dtype=np.float32, copy=True))
+    # The 4B model ties the LM head to its input embedding table.
+    if "output.weight" not in result:
+        result["output.weight"] = result["tok_embeddings.weight"]
+    return result
