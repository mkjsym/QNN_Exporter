new file mode 100644
index 0000000..493fc76
--- /dev/null
+++ b/examples/qualcomm/oss_scripts/llama/inference/qwen3_vl.py
@@ -0,0 +1,135 @@
+"""Calibrate on actual mtmd image embeddings and DeepStack features.
+
+Each calibration sample replays one complete fixture, chunking exactly like the
+runtime and retaining KV only within that prompt. Token-only calibration is refused.
+"""
+import json
+import os
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from executorch.examples.qualcomm.oss_scripts.llama.masking_utils import PADDING_MASK_VALUE
+
+
+class Qwen3VLDecoderInference:
+    def __init__(self, get_example_inputs, fixtures):
+        if not fixtures:
+            raise ValueError("Qwen3-VL requires --vlm_calibration with real image fixture JSON files")
+        ex = get_example_inputs()
+        if len(ex) not in (9, 10) or ex[0].shape[0] != 1:
+            raise ValueError("Qwen3-VL calibration requires a batch-1 explicit multimodal interface")
+        self.ar_len, self.dim = ex[0].shape[1:]
+        self._default_attn_mask, self._k, self._v = ex[1], ex[-2], ex[-1]
+        self._slot = ex[7] if len(ex) == 10 else None   # deep-register variant: per-row one-hot slot
+        # Deep-register variant: every fixture is followed by its K register rows (the drafter's register table as the
+        # embedding, zero DeepStack, text positions continuing the page, slot k one-hot) so the baked prompt path is
+        # calibrated on real prompt values. The first export calibrated with zero slots and the prompts did not survive
+        # quantization (device deep arm at the none-arm level, 2026-10-19).
+        self._registers = None
+        registers = os.environ.get("QNN_VLM_CALIB_REGISTERS")
+        if self._slot is not None:
+            if not registers:
+                raise ValueError("deep-register calibration needs QNN_VLM_CALIB_REGISTERS (f32 [K, dim] register table)")
+            k = int(self._slot.shape[-1])
+            data = np.fromfile(registers, dtype="<f4")
+            if data.size != k * self.dim or not np.isfinite(data).all():
+                raise ValueError(f"register table must be f32 [{k}, {self.dim}]: {registers}")
+            self._registers = torch.from_numpy(data.reshape(k, self.dim).copy())
+        elif registers:
+            # Plain (dflash) variant with dynamic registers (M6 re-calibration, 2026-10-22): on the device the drafter's register
+            # table rows ride as side rows of every verification call (dynreg8@T23), so the plain target's activation encodings
+            # must see those rows too. The first plain export calibrated without them and the dynreg8 arm lost AL on the device
+            # (device/host 0.974) while the deep target, calibrated with its rows, did not (0.998). Same row synthesis as the
+            # deep variant below, without the one-hot prompt slots (the plain graph has none).
+            data = np.fromfile(registers, dtype="<f4")
+            if data.size == 0 or data.size % self.dim or not np.isfinite(data).all():
+                raise ValueError(f"register table must be f32 [K, {self.dim}]: {registers}")
+            self._registers = torch.from_numpy(data.reshape(-1, self.dim).copy())
+        self._fixtures = []
+        self._slot_index = []
+        for name in fixtures:
+            path = Path(name)
+            meta = json.loads(path.read_text())
+            if meta.get("format_version") != 1 or meta.get("dim") != self.dim or meta.get("image_rows", 0) <= 0:
+                raise ValueError(f"not a Qwen3-VL image fixture: {path}")
+            prefix = path.with_suffix("")
+            values = []
+            for role in ("vlm_embd", "vlm_rope_cos", "vlm_rope_sin", "vlm_deepstack_0", "vlm_deepstack_1", "vlm_deepstack_2"):
+                dim = 64 if "rope" in role else self.dim
+                data = np.fromfile(str(prefix) + f".{role}.f32", dtype="<f4")
+                if data.size != meta["rows"] * dim or not np.isfinite(data).all():
+                    raise ValueError(f"malformed fixture tensor: {prefix}.{role}")
+                values.append(torch.from_numpy(data.reshape(meta["rows"], dim)))
+            slot_index = torch.full((meta["rows"],), -1, dtype=torch.long)
+            if self._registers is not None:
+                positions = np.fromfile(str(prefix) + ".positions.i32", dtype="<i4")
+                if positions.size != meta["rows"] * 3:
+                    raise ValueError(f"malformed fixture positions: {prefix}")
+                last = int(positions.reshape(meta["rows"], 3)[-1].max())
+                k = self._registers.shape[0]
+                q = torch.arange(last + 1, last + 1 + k, dtype=torch.float64)[:, None]
+                inv = 5e6 ** (-torch.arange(0, meta["head_dim"], 2, dtype=torch.float64) / meta["head_dim"])   # Qwen3-VL text rows: all MRoPE axes equal
+                check_q = torch.tensor([float(last)])[:, None]
+                if (torch.cos(check_q * inv).float() - values[1][-1]).abs().max() > 1e-3:
+                    raise ValueError(f"RoPE synthesis does not reproduce the fixture's last row: {prefix}")
+                extra = [self._registers, torch.cos(q * inv).float(), torch.sin(q * inv).float()] + [torch.zeros(k, self.dim)] * 3
+                values = [torch.cat((v, e), 0) for v, e in zip(values, extra)]
+                slot_index = torch.cat((slot_index, torch.arange(k)))
+            if values[0].shape[0] > self._k[0].shape[-1]:
+                raise ValueError("fixture exceeds this graph's persistent KV capacity")
+            self._fixtures.append(values)
+            self._slot_index.append(slot_index)
+        self._cursor = 0
+
+    def _inputs(self, fixture, offset, keys, values, slot_index=None):
+        n = min(self.ar_len, fixture[0].shape[0] - offset)
+        data = []
+        for j, tensor in enumerate(fixture):
+            padded = torch.full((self.ar_len, tensor.shape[1]), 1.0 if j == 1 else 0.0)
+            padded[:n] = tensor[offset:offset + n]
+            data.append(padded if j in (1, 2) else padded.unsqueeze(0))
+        cache_len = keys[0].shape[-1]
+        mask = torch.full((1, 1, self.ar_len, cache_len + self.ar_len), PADDING_MASK_VALUE)
+        mask[..., :offset] = 0
+        for row in range(self.ar_len):
+            mask[..., row, cache_len:cache_len + min(row + 1, n)] = 0
+        extra = ()
+        if self._slot is not None:
+            slot = torch.zeros_like(self._slot)
+            if slot_index is not None:
+                for row in range(n):
+                    k = int(slot_index[offset + row])
+                    if k >= 0:
+                        slot[0, row, k] = 1.0
+            extra = (slot,)
+        return (data[0], mask, *data[1:], *extra, *keys, *values), n
+
+    def make_forward_fn(self):
+        def forward(model, model_inputs):
+            fixture = self._fixtures[self._cursor % len(self._fixtures)]
+            slot_index = self._slot_index[self._cursor % len(self._fixtures)]
+            self._cursor += 1
+            keys, values = [torch.zeros_like(k) for k in self._k], [torch.zeros_like(v) for v in self._v]
+            logits = []
+            for offset in range(0, fixture[0].shape[0], self.ar_len):
+                args, n = self._inputs(fixture, offset, keys, values, slot_index)
+                out = model(*args)
+                logits.append(out[0][:, :n])
+                flat = []
+                for item in out[1:]:
+                    flat.extend(item) if isinstance(item, (tuple, list)) else flat.append(item)
+                half = len(flat) // 2
+                if half != len(keys):
+                    raise ValueError("Qwen3-VL calibration KV output count mismatch")
+                for i in range(half):
+                    keys[i][..., offset:offset + n] = flat[i][..., :n].detach()
+                    values[i][..., offset:offset + n, :] = flat[half + i][..., :n, :].detach()
+            return torch.cat(logits, dim=1)
+        return forward
+
+    @torch.no_grad()
+    def predict_step(self, module, input_ids, attn_mask=None, hidden_states=(), tok_embedding=None):
+        # PTQStrategy calls predict_step, so replay the complete image prefix here too.
+        return self.make_forward_fn()(module, {"input_ids": input_ids})
